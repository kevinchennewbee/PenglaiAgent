            print(l)
        return 0
    return subprocess.run(["journalctl", "-u", SERVICES[0], "-n", "30", "--no-pager"]).returncode

# ---------- update（安全自更新：预检 → 后台监工重启 → 健康检查 → 失败自动回滚 → 带外回报）----------
def is_git_repo():
    return sh(["git", "rev-parse", "--is-inside-work-tree"], cwd=ROOT).stdout.strip() == "true"

def _in_docker():
    return os.environ.get("PENGLAI_DOCKER") == "1" or os.path.exists("/.dockerenv")

REINSTALL_HINT = ("curl -fsSL https://raw.githubusercontent.com/"
                  "kevinchennewbee/PenglaiAgent/main/install.sh | sh")
DOCKER_UPDATE_HINT = ("curl -fsSL https://gh-proxy.com/https://raw.githubusercontent.com/"
                      "kevinchennewbee/PenglaiAgent/main/docker-install.sh | sh")
UPDATE_LOG = os.path.join(ROOT, "temp", "update.log")

def _git(*args):
    cmd = ["git", *args]
    kw = {}
    if args and args[0] == "fetch":
        # 国内直连 GitHub 有时不是立刻失败，而是低速半开卡住。给 fetch 加
        # 明确低速阈值和总超时，失败后 _fetch_status() 才能快速切到 gh-proxy。
        cmd = ["git", "-c", "http.lowSpeedLimit=1024", "-c", "http.lowSpeedTime=8", *args]
        kw["timeout"] = 35
    try:
        return sh(cmd, cwd=ROOT, **kw)
    except subprocess.TimeoutExpired as e:
        out = e.stdout if isinstance(e.stdout, str) else (e.stdout or b"").decode("utf-8", "replace")
        err = e.stderr if isinstance(e.stderr, str) else (e.stderr or b"").decode("utf-8", "replace")
        return subprocess.CompletedProcess(cmd, 124, out, err or f"git fetch 在 {e.timeout} 秒后超时")


def _release_remote():
    preferred = os.environ.get("PENGLAI_RELEASE_REMOTE", "").strip()
    if preferred and _git("remote", "get-url", preferred).returncode == 0:
        return preferred
    for name in ("origin", "release"):
        r = _git("remote", "get-url", name)
        if r.returncode == 0 and "PenglaiAgent" in (r.stdout or ""):
            return name
    return "origin"


def _release_ref(remote=None):
    return f"{remote or _release_remote()}/main"

def _gh_proxy(url):
    """把 github.com 直连 URL 包成可配置 GitHub 镜像（国内 GFW 兜底，与 install.sh 同源）。
    非 github / 已是镜像 返回空串。"""
    url = (url or "").strip()
    proxy = os.environ.get("PENGLAI_GH_PROXY", "https://gh-proxy.com/").strip()
    if proxy and not proxy.endswith("/"):
        proxy += "/"
    if not url or not proxy or url.startswith(proxy) or "github.com" not in url:
        return ""
    return proxy + url

def _fetch_status():
    """返回 (ok, behind, oldsha, newsha, errmsg)。处理浅克隆补全 + ff 可行性。"""
    if not is_git_repo():
        return False, 0, "", "", f"压缩包安装（无 git 历史），无法增量更新。重装即最新：\n   {REINSTALL_HINT}"
    remote = _release_remote()
    ref = _release_ref(remote)
    if _git("rev-parse", "--is-shallow-repository").stdout.strip() == "true":
        print("  首次检查：补全 git 历史（浅克隆 → 完整）...")
        _git("fetch", "--unshallow", remote)
    if _git("fetch", remote).returncode != 0:
        # F5：直连 GitHub 失败（国内 GFW）→ 走可配置 GitHub 镜像，把 main 拉进 origin/main 同一 ref
        proxied = _gh_proxy(_git("remote", "get-url", remote).stdout.strip())
        if not proxied or _git("fetch", proxied, f"main:refs/remotes/{remote}/main").returncode != 0:
            return False, 0, "", "", "拉取失败（直连与 GitHub 镜像均失败，检查网络/代理）"
        print("  （直连 GitHub 失败，已走 GitHub 镜像拉取）")
    old = _git("rev-parse", "HEAD").stdout.strip()
    new = _git("rev-parse", ref).stdout.strip()
    behind = int(_git("rev-list", "--count", f"HEAD..{ref}").stdout.strip() or "0")
    return True, behind, old, new, ""

def _changelog(old, new):
    r = _git("log", "--oneline", "--no-decorate", f"{old}..{new}")
    return [l for l in r.stdout.splitlines() if l.strip()]

def _preflight():
    """重启前冒烟：①全仓编译（语法）②安全插件 import+挂载。返回 (ok, detail)。
    新代码连编译/挂载都过不了，就根本不碰正在跑的服务（在杀服务之前拦住坏更新）。"""
    c = sh([venv_python(), "-m", "compileall", "-q", ROOT])
    if c.returncode != 0:
        return False, "编译失败：" + (c.stdout or c.stderr or "")[:200]
    g = sh([venv_python(), os.path.join(ROOT, "penglai"), "_guardcheck"])
    if g.returncode != 0:
        return False, "安全插件挂载失败：" + (g.stdout or "")[:200]
    legacy = sh([venv_python(), os.path.join(ROOT, "penglai"), "runtime-audit", "--json"])
    if legacy.returncode != 0:
        return False, "旧 Runtime 入口审计失败：" + ((legacy.stdout or legacy.stderr or "")[:300])
    try:
        data = json.loads(legacy.stdout or "{}")
    except Exception:
        return False, "旧 Runtime 入口审计输出不可解析"
    active = [
        item.get("item_id", "active_legacy_path")
        for item in data.get("items", [])
        if item.get("status") == "active_legacy_path"
    ]
    if active:
        return False, "旧 Runtime 入口仍在运行，0.3.0 preview 不做原地重启升级：" + ", ".join(active[:5])
    return True, ""

def update():
    """安全更新到最新版蓬莱发行仓。用法：
       penglai update           交互式：显示更新内容 → 确认 → 安全升级
       penglai update --check   只检查不升级（管家先用这个报告，用户确认后再 --apply）
       penglai update --apply   已确认，直接执行安全升级（预检→后台重启→健康检查→失败回滚）
    不在用户机 merge lsdefine 上游（浅克隆 unrelated-histories 必炸，F-013），只跟随发行仓。"""
    flag = sys.argv[2] if len(sys.argv) > 2 else ""
    # Docker：代码在镜像里不在卷里，git pull 无意义——指向镜像升级路径
    if _in_docker():
        print(f"{WARN}容器形态：升级 = 拉取新镜像，不是 git 更新。重跑一行（数据在卷里不丢）：")
        print(f"   {DOCKER_UPDATE_HINT}")
        return 0
    print("🔄 检查蓬莱更新 ...")
    ok, behind, old, new, err = _fetch_status()
    if not ok:
        print(f"{BAD} {err}"); return 1
    if behind == 0:
        print(f"{OK} 已是最新版蓬莱。"); return 0
    logs = _changelog(old, new)
    print(f"\n  发行仓有 {behind} 个新提交（{old[:7]} → {new[:7]}）：")
    for l in logs[:12]:
        print("   • " + l)
    if flag == "--check":
        print(f"\n  确认升级请运行：penglai update --apply（或 penglai update 交互确认）")
        return 0
    if flag != "--apply":
        # 交互确认（CLI 直接跑）。非 tty 又没 --apply 则不擅自升级。
        if not (sys.stdin.isatty() and sys.stdout.isatty()):
            print(f"\n  非交互环境：确认后用 penglai update --apply 执行"); return 0
        try:
            ans = input("\n  升级并自动重启？失败会自动回滚 (y/n): ").strip().lower()
        except EOFError:
            ans = ""
        if not ans.startswith("y"):
            print("  已取消。"); return 0
    return _do_update(old, new)

def _do_update(old, new):
    if _git("status", "--porcelain").stdout.strip():
        print(f"{BAD} 本地有未提交改动，0.3.0 preview 不继续自动升级，避免回滚时丢失本地修改。请先提交/备份后再运行 update。")
        return 1
    print("  ⬇️  拉取新版本（fast-forward）...")
    if subprocess.run(["git", "merge", "--ff-only", _release_ref()], cwd=ROOT).returncode != 0:
        print(f"{BAD} 无法 fast-forward（本地改动/历史分叉），未改动。备份 mykey 后重装即最新：\n   {REINSTALL_HINT}")
        return 1
    print("  🔍 预检新版本（编译 + 安全插件挂载）...")
    pok, detail = _preflight()
    if not pok:
        print(f"{BAD} 预检失败，已回滚，未重启服务（服务仍在旧版正常运行）：\n   {detail}")
        _git("reset", "--hard", old)
        return 1
    print(f"  {OK} 预检通过。后台监工将重启服务并健康检查，失败自动回滚——结果发到你的 IM。")
    # 派生脱离进程组的监工：它不是当前 agent/fsapp 的子进程，重启杀掉本进程也不影响它
    os.makedirs(os.path.dirname(UPDATE_LOG), exist_ok=True)
    lf = open(UPDATE_LOG, "ab")
    subprocess.Popen([venv_python(), os.path.join(ROOT, "penglai"), "_update_supervisor", old, new],
                     cwd=ROOT, stdout=lf, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                     start_new_session=True)
    print(f"  已升级到 {new[:7]}，正在后台重启自检（约 1 分钟）。这条之后服务会重启，稍候我会把结果发给你。")
    return 0

def _restart_targets():
    """应处于运行态的服务（systemd）。渠道按配置和已安装 unit 决定。"""
    svcs = ["penglai-runtime-hub", "penglai-scheduler"]
    py = venv_python()
    fs = sh([py, "-c", "import sys;sys.path.insert(0,'.');import mykey;"
             "print(1 if getattr(mykey,'fs_app_id','') and getattr(mykey,'fs_app_secret','') else 0)"],
            cwd=ROOT).stdout.strip()
    if fs == "1":
        svcs.append("penglai-feishu")
    if os.path.exists(os.path.expanduser("~/.wxbot/token.json")):
        svcs.append("penglai-wechat")
    cp = sh([py, "-c", "import sys;sys.path.insert(0,'.');import mykey;"
             "print(1 if getattr(mykey,'companion_enabled',False) else 0)"], cwd=ROOT).stdout.strip()
    if cp == "1":
        svcs.append("penglai-companion")
    return [s for s in svcs if s in installed_services()] or ["penglai-feishu"]

def _restart(svcs):
    """无 tty 安全重启：优先免密 sudo systemctl；否则 kill 自己用户的进程靠 Restart=always 复活。"""
    if not has_systemd():
        fsapp_stop(); fsapp_start(); _ensure_macos_reflects(force=True); return
    if sh(["sudo", "-n", "systemctl", "restart", *svcs]).returncode == 0:
        return
    # 无免密 sudo：服务 User= 与本进程同用户，可直接杀；systemd Restart=always 会拉起新代码
    for pat in ("penglai_feishu_app[.]py", "frontends/fsapp[.]py", "penglai_im_launch[.]py wechat",
                "reflect/scheduler[.]py", "reflect/penglai_companion[.]py"):
        sh(["pkill", "-f", pat])

def _health_baseline():
    """重启前快照：systemd 路径记时刻、nohup 路径记 FSLOG 字节偏移。健康检查据此只认
    【本次重启之后】的连接证据——否则固定 -3min 窗口会把重启前的旧 connected 当成功，
    坏更新被误判健康而不回滚（round4 真机实测的假阳 bug）。"""
    import time
    return (time.time(), os.path.getsize(FSLOG) if os.path.exists(FSLOG) else 0)

def _channel_health(baseline=None):
    """返回 (ok, detail)：核心渠道服务 active 且【baseline 之后】日志见连接证据。
    baseline=None 退回 -3min 窗口（doctor 等非升级场景）。"""
    import time
    py = venv_python()
    fs = sh([py, "-c", "import sys;sys.path.insert(0,'.');import mykey;"
             "print(1 if getattr(mykey,'fs_app_id','') and getattr(mykey,'fs_app_secret','') else 0)"],
            cwd=ROOT).stdout.strip()
    checks = []
    if fs == "1":
        checks.append(("penglai-feishu", "connected to wss"))
    if os.path.exists(os.path.expanduser("~/.wxbot/token.json")):
        checks.append(("penglai-wechat", "WeChat Bot 已启动"))
    if not checks:
        checks = [("penglai-feishu", "connected to wss")]
    bad = []
    for svc_name, pat in checks:
        if has_systemd():
            active = sh(["systemctl", "is-active", svc_name]).stdout.strip() == "active"
            since = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(baseline[0])) if baseline else "-3 min"
            logtxt = sh(["journalctl", "-u", svc_name, "--since", since, "--no-pager"]).stdout
        else:
            active = bool(fsapp_pids())
            logtxt = ""
            if os.path.exists(FSLOG):
                with open(FSLOG, "rb") as f:
                    if baseline:
                        f.seek(baseline[1])        # 只读重启后新增部分
                    logtxt = f.read().decode("utf-8", "replace")
        if not (active and pat in logtxt):
            bad.append(svc_name)
    return (not bad), (", ".join(bad) if bad else "")

def _notify_owner(text):
    """带外把结果发到主人 IM（飞书 + 微信）。监工进程用，不依赖 agent 存活。
    委托给可 import 的公开原语 penglai_abilities.notify_owner（U8：单一实现，
    agent/脚本也能 `from penglai_abilities import notify_owner` 复用，不必猜 import penglai）。"""
    sys.path.insert(0, ROOT)
    try:
        from penglai_abilities import notify_owner
        return notify_owner(text)
    except Exception:
        return False

def update_supervisor():
    """脱离进程组的后台监工：重启 → 健康检查 → 失败 git 回滚 + 重启 → 带外回报。
    被 _do_update 以 setsid 派生，绝不是 agent/fsapp 的子进程，故重启杀掉它们不影响本进程。"""
    import time
    old = sys.argv[2] if len(sys.argv) > 2 else ""
    new = sys.argv[3] if len(sys.argv) > 3 else ""
    def log(m): print(f"[update_supervisor] {m}", flush=True)
    time.sleep(6)  # 给 agent 那条「正在升级」回复留出送达时间
    svcs = _restart_targets()
    log(f"重启服务: {svcs}")
    base = _health_baseline()        # 重启前基线：只认其后的新连接证据
    _restart(svcs)
    # 轮询健康（≤90s）
    healthy = False; bad = ""
    for _ in range(45):
        time.sleep(2)
        ok, bad = _channel_health(base)
        if ok:
            healthy = True; break
    if healthy:
        log("健康检查通过")
        _notify_owner(f"✅ 蓬莱已升级到 {new[:7]} 并重启完成，一切正常。")
        return 0
    # 不健康 → 回滚
    log(f"健康检查未通过（{bad}），回滚到 {old[:7]}")
    _git("reset", "--hard", old)
    base = _health_baseline()        # 回滚重启前基线
    _restart(svcs)
    for _ in range(45):
        time.sleep(2)
        if _channel_health(base)[0]:
            _notify_owner(f"⚠️ 新版本 {new[:7]} 启动失败，已自动回滚到 {old[:7]}，服务已恢复正常。"
                          f"（详情见服务器 temp/update.log）")
            return 0
    _notify_owner(f"🆘 升级到 {new[:7]} 失败且回滚后仍未恢复，请上服务器看 temp/update.log 与 penglai doctor。")
    return 1

def restart_supervisor():
    """脱离进程组的后台监工：重启服务 → 健康检查 → 带外回报『我回来了』。
    被 svc('restart') 在非 tty(agent/IM)触发时以 setsid 派生，绝不是 fsapp 的子进程，
    故重启杀掉 fsapp 不影响本进程。U7：给 restart 配上 update 同款的『重启完通知主人』，
    省得 agent 临场手写 restart 脚本（还把 import penglai 写崩）。复用 notify_owner（U8）。"""
    import time
    def log(m): print(f"[restart_supervisor] {m}", flush=True)
    # 自锁：避免两个重启监工并发重启互踩；陈旧锁(>5min，上次崩了没删)自动接管
    lock = os.path.join(ROOT, "temp", "restart_supervisor.lock")
    try:
        os.close(os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY))
    except FileExistsError:
        try:
            if time.time() - os.path.getmtime(lock) < 300:
                log("已有重启监工在跑，退出"); return 0
        except Exception:
            pass
        log("发现陈旧锁，接管")
    try:
        time.sleep(5)  # 给 agent 那条「我去重启，约15秒回来」留送达时间
        base = _health_baseline()        # 重启前基线：只认其后的新连接证据
        svcs = _restart_targets() if has_systemd() else []
        log(f"重启: {svcs or 'fsapp(nohup)'}")
        _restart(svcs)
        for _ in range(45):              # 最多 90s
            time.sleep(2)
            if _channel_health(base)[0]:
                log("健康检查通过")
                _notify_owner("✅ 我回来啦——重启完成，刚才配的能力已生效，继续聊就行。")
                return 0
        log("健康检查 90s 未通过")
        _notify_owner("⚠️ 我重启后 90 秒没看到飞书重连，麻烦发条消息试试，或在服务器跑 penglai doctor。")
        return 1
    finally:
        try: os.remove(lock)
        except Exception: pass

