{
  "name": "@penglai/office",
  "version": "0.5.7",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    }
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2",
    "@liustack/pptfast": "0.20.0",
    "@penglai/artifacts": "workspace:*",
    "@penglai/contracts": "workspace:*",
    "@penglai/runtime": "workspace:*",
    "@pdf-lib/fontkit": "1.1.1",
    "docx": "9.7.1",
    "exceljs": "4.4.0",
    "pdf-lib": "1.17.1"
  }
}
