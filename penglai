def tts_voices_cmd():
    """penglai tts-voices [--json]

    列出可用声音档案（0.3.5 新增）。
    """
    sys.path.insert(0, ROOT)
    from penglai_runtime import voice_profiles
    import json as _json
    voices = voice_profiles.list_voice_profiles(public_only=True)
    use_json = "--json" in sys.argv[2:]
    if use_json:
        print(_json.dumps({"voices": voices}, ensure_ascii=False, indent=2))
        return 0
    if not voices:
        print("（无可用声音）")
        return 0
    print("可用声音档案（公开）：")
    cur_lang = None
    for v in voices:
        if v["lang"] != cur_lang:
            cur_lang = v["lang"]
            lang_label = "中文" if cur_lang == "zh" else "英文"
            print(f"\n  [{lang_label}]")
        gender_label = "男声" if v["gender"] == "male" else "女声"
        personas = ", ".join(v["persona_hints"]) if v["persona_hints"] else "-"
        print(f"    {v['voice_id']:<12} {gender_label}  {v['label']}  人格: {personas}")
    print("\n配置：在 mykey.py 设置 companion_voice_gender = 'male'|'female'|'auto'")
    return 0

