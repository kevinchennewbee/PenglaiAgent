def restore_cmd(backup_path=None):
    """penglai restore [备份路径] — 从完整备份恢复"""
    import glob
    if backup_path:
        src = backup_path if os.path.isabs(backup_path) else os.path.join(BACKUP_DIR, backup_path)
    else:
        cands = sorted(glob.glob(os.path.join(BACKUP_DIR, "full-*")))
        if not cands:
            print(f"{BAD} 没有完整备份可恢复（{BACKUP_DIR} 中无 full-* 目录）。先运行：penglai backup")
            return 1
        src = cands[-1]

    if not os.path.isdir(src):
        print(f"{BAD} 备份目录不存在：{src}")
        return 1

    current_has_data = any(
        os.path.exists(path)
        for path in (
            _mykey_path(),
            os.path.join(ROOT, "memory"),
            os.path.join(ROOT, "temp", "runtime_hub.sqlite3"),
            os.path.expanduser("~/.wxbot/token.json"),
            os.path.expanduser("~/.penglai_desktop_settings.json"),
        )
    )
    if current_has_data:
        print(f"{WARN} 恢复前先自动备份当前数据，避免恢复失败导致覆盖丢失。")
        pre_rc = backup_cmd()
        if pre_rc != 0:
            print(f"{BAD} 恢复前备份失败，已停止恢复。")
            return pre_rc

    items = []
    # mykey.py
    mykey_bak = os.path.join(src, "mykey.py")
    if os.path.exists(mykey_bak):
        _copy_file_atomic(mykey_bak, _mykey_path())
        items.append("mykey.py")
    # memory/
    mem_bak = os.path.join(src, "memory")
    if os.path.isdir(mem_bak):
        mem_dst = os.path.join(ROOT, "memory")
        _replace_tree_atomic(mem_bak, mem_dst)
        items.append("memory/")
    # temp/runtime_hub.sqlite3
    sqlite_bak = os.path.join(src, "temp", "runtime_hub.sqlite3")
    if os.path.exists(sqlite_bak):
        sqlite_dst = os.path.join(ROOT, "temp", "runtime_hub.sqlite3")
        _copy_sqlite_consistent(sqlite_bak, sqlite_dst)
        items.append("temp/runtime_hub.sqlite3")
    # ~/.wxbot/token.json
    wxbot_bak = os.path.join(src, ".wxbot", "token.json")
    if os.path.exists(wxbot_bak):
        wxbot_dst = os.path.expanduser("~/.wxbot/token.json")
        _copy_file_atomic(wxbot_bak, wxbot_dst)
        items.append("~/.wxbot/token.json")
    # ~/.penglai_desktop_settings.json
    desktop_bak = os.path.join(src, ".penglai_desktop_settings.json")
    if os.path.exists(desktop_bak):
        desktop_dst = os.path.expanduser("~/.penglai_desktop_settings.json")
        _copy_file_atomic(desktop_bak, desktop_dst)
        items.append("~/.penglai_desktop_settings.json")

    if not items:
        print(f"{BAD} 备份目录为空：{src}")
        return 1

    print(f"{OK} 已从备份恢复 → {src}")
    print(f"  恢复内容：{', '.join(items)}")
    return 0

def uninstall_legacy_cmd():
    """penglai uninstall-legacy — 检测并清理旧版本服务"""
    print("检测旧版本服务和数据...")

    cleaned = []

    # 1. 检测旧 launchd 服务（macOS）
    if sys.platform == "darwin":
        import glob
        plists = glob.glob(os.path.expanduser("~/Library/LaunchAgents/com.penglai.*.plist"))
        for plist in plists:
            label = os.path.basename(plist).replace(".plist", "")
            subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}/{label}"],
                         capture_output=True)
            os.remove(plist)
            cleaned.append(f"launchd: {label}")

    # 2. 检测旧 systemd 服务（Linux）
    elif sys.platform.startswith("linux"):
        for svc in ["penglai-feishu", "penglai-scheduler", "penglai-companion",
                     "penglai-wechat", "penglai-runtime-hub"]:
            r = subprocess.run(["systemctl", "is-active", svc], capture_output=True, text=True)
            if r.stdout.strip() == "active":
                subprocess.run(["systemctl", "stop", svc], capture_output=True)
                cleaned.append(f"systemd: stopped {svc}")
            r = subprocess.run(["systemctl", "is-enabled", svc], capture_output=True, text=True)
            if r.stdout.strip() == "enabled":
                subprocess.run(["systemctl", "disable", svc], capture_output=True)
                cleaned.append(f"systemd: disabled {svc}")

    # 3. 检测旧安装目录
    legacy_dirs = []
    for d in ["~/PenglaiAgent", "~/PenglaiAgentDesktop", "~/PenglaiAgentOld"]:
        full = os.path.expanduser(d)
        if os.path.isdir(full) and os.path.abspath(full) != os.path.abspath(ROOT):
            legacy_dirs.append(full)

    if not cleaned and not legacy_dirs:
        print(f"{OK} 未检测到旧版本服务或数据")
        return 0

    if cleaned:
        print(f"{OK} 已清理旧服务：")
        for item in cleaned:
            print(f"  - {item}")

    if legacy_dirs:
        print(f"\n⚠️  检测到旧安装目录（需手动删除）：")
        for d in legacy_dirs:
            print(f"  - {d}")
        print(f"\n  建议先确认数据已迁移，再手动删除：")
        for d in legacy_dirs:
            print(f"  rm -rf {d}")

    return 0

