#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""penglai — 蓬莱助手发行版唯一入口（基于 GenericAgent，执行核心 upstream-first）。

用法:
  penglai           直接对话（终端 TUI，等价上游 GA 的 tuiapp_v2）
  penglai doctor    体检：环境/依赖/配置/服务/记忆/上游状态
  penglai version   版本身份（发行版本/Runtime/分支/commit/构建信息）
  penglai status    服务状态
  penglai start     启动服务（飞书 + 微信 + 调度器）
  penglai stop      停止服务
  penglai logs [渠道]  查看最近日志（默认飞书）
  penglai channels [--json]  IM 渠道矩阵总览（飞书/微信/钉钉/企微/QQ/Telegram/Discord，含下一步命令）
  penglai enable <渠道>   启用渠道（钉钉/QQ 支持扫码自动建应用）
  penglai disable <渠道>  停用渠道
  penglai config <backup|restore|status>  配置管理（backup 原子备份 / restore 回滚 / status --json 概览）
  penglai backup   完整数据备份（mykey/memory/sqlite/wxbot/桌面配置，用于版本迁移前）
  penglai restore [备份路径]  从完整备份恢复（默认最近一次 full-<timestamp>）
  penglai uninstall-legacy  检测并清理旧版本服务与残留目录（launchd/systemd）
  penglai update    更新到最新版蓬莱发行仓
  penglai setup [--only <模块>] [--skip-smoke-test]  安装向导（--only 局部补配：llm|identity|feishu|wechat|channels|abilities|companion；--skip-smoke-test 跳过端到端 LLM 冒烟验证）
  penglai migrate   从旧管家(Hermes/OpenClaw)搬家：记忆/渠道/人设 [--from][--dry-run][--with-secrets]
  penglai skill     技能集市：list 看可用 / install <名> 启用 / installed / remove <名>（本地装不联网）
  penglai selfcheck 运行时自检（统一会话/排队/交付/交互/记忆卫生）
  penglai runtime-run [消息]  本地中枢 0.3.0 链路（真实调用 GA）
  penglai runtime-chat       终端多轮中枢入口（真实调用 GA）
  penglai runtime-status     查看中枢 session 状态
  penglai runtime-history    查看中枢运行单历史
  penglai runtime-cancel     取消当前中枢 session
  penglai runtime-serve      启动本机中枢控制 API（localhost + token）
  penglai runtime-service <install|uninstall|status|print-unit>  管理本机中枢服务
  penglai runtime-audit      审计 0.3.0 旧入口和不支持的发布口径（低副作用）
  penglai privacy-audit      审计隐私与发布前风险（低副作用，不输出密钥）
  penglai install-check      源码安装预检（0.3.0，无 Docker，低副作用）
  penglai tts-smoke          MOSS-TTS-Nano 本地语音输出中英真实合成验证
  penglai tts-say <文本>     合成文本为本地 WAV，并输出可投递音频 artifact
  penglai tts-feishu-test    合成语音并通过飞书 owner 真实投递验证
  penglai feishu-service <install|uninstall|status|print-unit|run-gray>  管理无头服务器上的飞书渠道进程
  penglai companion <status|enable|mode|pause|resume|why|test>  主动陪伴管理（--json 支持）
  penglai help      显示本帮助
"""
import json, os, sys, shutil, sqlite3, subprocess, uuid

# realpath 而非 abspath：install.sh 会软链 ~/.local/bin/penglai → 仓库内本体，
# abspath 会把 ROOT 解析到 ~/.local/bin，整个发行版找不到自己（真机踩过）
ROOT = os.path.dirname(os.path.realpath(__file__))
SERVICES = ["penglai-feishu", "penglai-scheduler", "penglai-runtime-hub", "penglai-companion", "penglai-wechat",
            "penglai-dingtalk", "penglai-wecom2", "penglai-qq", "penglai-telegram", "penglai-discord"]
OPTIN_SERVICES = {"penglai-feishu": "飞书渠道进程", "penglai-runtime-hub": "本机中枢控制 API", "penglai-companion": "主动陪伴", "penglai-wechat": "微信渠道",
                  "penglai-dingtalk": "钉钉渠道", "penglai-wecom2": "企业微信渠道",
                  "penglai-qq": "QQ渠道", "penglai-telegram": "Telegram渠道",
                  "penglai-discord": "Discord渠道"}  # 未装≠故障
# 服务未启用时，doctor 直接给出"怎么开"的命令（发现→开启闭环）
SVC_ENABLE = {"penglai-feishu": "penglai feishu-service install", "penglai-runtime-hub": "penglai runtime-service install", "penglai-companion": "penglai enable companion", "penglai-wechat": "penglai setup",
              "penglai-dingtalk": "penglai enable dingtalk", "penglai-wecom2": "penglai enable wecom",
              "penglai-qq": "penglai enable qq", "penglai-telegram": "penglai enable telegram",
              "penglai-discord": "penglai enable discord"}
OK, BAD, WARN = "✅", "❌", "⚠️ "

def sh(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)

def venv_python():
    p = os.path.join(ROOT, ".venv", "bin", "python")
    return p if os.path.exists(p) else sys.executable

def version():
    from penglai_runtime.version import format_version_text
    print(format_version_text())
    return 0

def has_systemd():
    return shutil.which("systemctl") is not None

# ---------- 无 systemd 环境（macOS 等）的进程管理 ----------
FSLOG = os.path.join(ROOT, "temp", "fsapp.log")
FSPID = os.path.join(ROOT, "temp", "fsapp.pid")
FSLOCK = os.path.join(ROOT, "temp", "fsapp.start.lock")
FSAPP_ENTRY = os.path.join(ROOT, "penglai_feishu_app.py")
FSAPP_WRAPPER_PATTERN = "penglai_feishu_app[.]py"
FSAPP_LEGACY_PATTERN = "frontends/fsapp[.]py"
FSAPP_PATTERNS = (FSAPP_WRAPPER_PATTERN, FSAPP_LEGACY_PATTERN)
WECHATLOG = os.path.join(ROOT, "temp", "wechat.log")
WECHATPID = os.path.join(ROOT, "temp", "wechat.pid")
WECHAT_ENTRY = os.path.join(ROOT, "penglai_im_launch.py")
WECHAT_PATTERNS = ("penglai_im_launch[.]py wechat", "frontends/wechatapp[.]py")

def _pids_for_patterns(patterns):
    pids = set()
    for pat in patterns:
        r = sh(["pgrep", "-f", pat])
        if r.returncode == 0:
            pids.update(int(x) for x in r.stdout.split() if x.strip().isdigit())
    return sorted(pids)

def fsapp_pids():
    return _pids_for_patterns(FSAPP_PATTERNS)

def wechat_pids():
    return _pids_for_patterns(WECHAT_PATTERNS)

def _reflect_pids(rel):
    return _pids_for_patterns((rel.replace("/", "[/]"),))

def fsapp_wrapper_pids():
    return _pids_for_patterns((FSAPP_WRAPPER_PATTERN,))

def fsapp_legacy_pids():
    return _pids_for_patterns((FSAPP_LEGACY_PATTERN,))

def _fsapp_launchd_label():
    return "com.penglai.feishu"

def _use_fsapp_launchd():
    return sys.platform == "darwin" and not has_systemd()

def _launchctl_bootout(label_id):
    return sh(["launchctl", "bootout", f"gui/{os.getuid()}/{label_id}"])

def _launchd_label(service):
    if service == "penglai-feishu":
        return _fsapp_launchd_label()
    return "com.penglai." + service.replace("penglai-", "")

def _launchd_loaded(service):
    if sys.platform != "darwin":
        return False
    return sh(["launchctl", "list", _launchd_label(service)]).returncode == 0

def _mykey_flag(expr):
    code = "import sys;sys.path.insert(0,'.');import mykey;" + expr
    return sh([venv_python(), "-c", code], cwd=ROOT).stdout.strip() == "1"

def _wechat_bound():
    return os.path.exists(os.path.expanduser("~/.wxbot/token.json"))

def _companion_enabled_flag():
    return _mykey_flag("print(1 if getattr(mykey,'companion_enabled',False) else 0)")

def _fsapp_launchd_start():
    import signal
    import time
    import penglai_abilities as pa
    os.makedirs(os.path.dirname(FSLOG), exist_ok=True)
    for pid in fsapp_pids():
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    if fsapp_pids():
        time.sleep(1.5)
    base = os.path.getsize(FSLOG) if os.path.exists(FSLOG) else 0
    ok = pa.install_launchd(_fsapp_launchd_label(), [venv_python(), FSAPP_ENTRY], FSLOG)
    if not ok:
        print(f"{WARN}飞书 launchd 注册未确认，降级为后台启动")
        return None
    deadline = time.monotonic() + 45
    while time.monotonic() < deadline:
        if os.path.exists(FSLOG):
            with open(FSLOG, "rb") as f:
                f.seek(base)
                if b"connected to wss" in f.read():
                    pids = fsapp_pids()
                    pid_text = f"PID {pids[0]}" if pids else "launchd"
                    print(f"{OK} 飞书已由 launchd 守护并建立长连接（{pid_text}，{_fsapp_launchd_label()}）")
                    return 0
        time.sleep(2)
    pids = fsapp_pids()
    print(f"{WARN}launchd 已注册，{'进程在跑' if pids else '但未见进程'}，45 秒未见连接成功，penglai logs 查看")
    return 1

def _child_env():
    """给 fsapp 子进程固化完整 PATH（含 venv 与 /opt/homebrew/bin），避免它继承被裁剪的 PATH
    导致其再起的子进程(如 ffmpeg)找不到——真实 macOS 运行中踩过的语音故障根因(F15)。"""
    env = dict(os.environ)
    vbin = os.path.join(ROOT, ".venv", "bin")
    extra = [vbin if os.path.isdir(vbin) else os.path.dirname(venv_python()),
             os.path.expanduser("~/.local/bin"), "/opt/homebrew/bin", "/usr/local/bin",
             "/usr/bin", "/bin", "/usr/sbin", "/sbin"]
    cur = [d for d in env.get("PATH", "").split(os.pathsep) if d]
    env["PATH"] = os.pathsep.join([d for d in extra if d] + [d for d in cur if d not in extra])
    return env

def fsapp_start():
    if _use_fsapp_launchd():
        r = _fsapp_launchd_start()
        if r is not None:
            return r
    import signal
    import time
    try: import fcntl
    except ImportError: fcntl = None
    os.makedirs(os.path.join(ROOT, "temp"), exist_ok=True)
    # F8 启动互斥锁：防并发 start 各自起进程造成重复 fsapp（真机混乱期踩过）
    lock_fd = os.open(FSLOCK, os.O_CREAT | os.O_RDWR, 0o644)
    try:
        if fcntl is not None:
            try:
                fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                print(f"{WARN}已有 penglai start 正在进行，跳过（避免重复进程）"); return 0
        legacy = fsapp_legacy_pids()
        wrapper = fsapp_wrapper_pids()
        if legacy:
            print(f"{WARN}发现旧飞书入口 frontends/fsapp.py（PID {' '.join(map(str, legacy))}），迁移到 penglai_feishu_app.py")
            for pid in legacy:
                try: os.kill(pid, signal.SIGTERM)
                except ProcessLookupError: pass
            time.sleep(1.5)
            legacy = fsapp_legacy_pids()
            if legacy:
                for pid in legacy:
                    try: os.kill(pid, signal.SIGKILL)
                    except ProcessLookupError: pass
                time.sleep(0.5)
        if wrapper:
            print(f"{OK} 飞书 wrapper 进程已在运行（PID {wrapper[0]}）"); return 0
        base = os.path.getsize(FSLOG) if os.path.exists(FSLOG) else 0  # 只认本次启动后的新连接
        lf = open(FSLOG, "ab")
        p = subprocess.Popen([venv_python(), FSAPP_ENTRY], cwd=ROOT,
                             stdout=lf, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                             env=_child_env(), start_new_session=True)
        try: open(FSPID, "w").write(str(p.pid))   # F12：写当前代 PID，别让 pid 文件停在第一代
        except OSError: pass
        deadline = time.monotonic() + 45
        while time.monotonic() < deadline:
            if p.poll() is not None:
                print(f"{BAD} 进程退出（码 {p.returncode}），最近日志：")
                for l in open(FSLOG, encoding="utf-8", errors="replace").read().splitlines()[-8:]:
                    print("  " + l[:160])
                return 1
            with open(FSLOG, "rb") as f:
                f.seek(base)
                if b"connected to wss" in f.read():
                    print(f"{OK} 飞书进程已启动且长连接已建立（PID {p.pid}，日志: penglai logs）")
                    return 0
            time.sleep(2)
        print(f"{WARN}进程在跑（PID {p.pid}）但 45 秒未见连接成功，penglai logs 查看")
        return 1
    finally:
        try: os.close(lock_fd)
        except OSError: pass

def fsapp_stop():
    import signal
    if _use_fsapp_launchd():
        _launchctl_bootout(_fsapp_launchd_label())
    pids = fsapp_pids()
    if not pids:
        print(f"{OK} 飞书进程未在运行"); return 0
    for pid in pids:
        try: os.kill(pid, signal.SIGTERM)
        except ProcessLookupError: pass
    print(f"{OK} 已停止（PID {' '.join(map(str, pids))}）"); return 0

def _spawn_background(argv, log, pidfile):
    os.makedirs(os.path.dirname(log), exist_ok=True)
    lf = open(log, "ab")
    p = subprocess.Popen(argv, cwd=ROOT, stdout=lf, stderr=subprocess.STDOUT,
                         stdin=subprocess.DEVNULL, env=_child_env(),
                         start_new_session=True)
    if pidfile:
        try:
            open(pidfile, "w").write(str(p.pid))
        except OSError:
            pass
    return p

def _kill_patterns(patterns, label):
    import signal
    pids = _pids_for_patterns(patterns)
    if not pids:
        print(f"{OK} {label}未在运行")
        return 0
    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    print(f"{OK} 已停止{label}（PID {' '.join(map(str, pids))}）")
    return 0

def wechat_start():
    if not _wechat_bound():
        print(f"{OK} 微信未绑定，跳过")
        return 0
    pids = wechat_pids()
    if pids:
        print(f"{OK} 微信进程已在运行（PID {pids[0]}）")
        return 0
    p = _spawn_background([venv_python(), WECHAT_ENTRY, "wechat"], WECHATLOG, WECHATPID)
    import time
    time.sleep(2)
    if p.poll() is not None:
        print(f"{BAD} 微信进程退出（码 {p.returncode}），最近日志：")
        if os.path.exists(WECHATLOG):
            for l in open(WECHATLOG, encoding="utf-8", errors="replace").read().splitlines()[-8:]:
                print("  " + l[:160])
        return 1
    print(f"{OK} 微信进程已临时后台启动（PID {p.pid}，日志: {WECHATLOG}）")
    return 0

def wechat_stop():
    return _kill_patterns(WECHAT_PATTERNS, "微信")

def _reflect_start(service, rel, label):
    pids = _reflect_pids(rel)
    if pids:
        print(f"{OK} {label}已在运行（PID {pids[0]}）")
        return 0
    log = os.path.join(ROOT, "temp", f"{service}.log")
    pidfile = os.path.join(ROOT, "temp", f"{service}.pid")
    p = _spawn_background([venv_python(), os.path.join(ROOT, "agentmain.py"),
                           "--reflect", os.path.join(ROOT, rel)], log, pidfile)
    print(f"{OK} {label}已临时后台启动（PID {p.pid}，日志: {log}）")
    return 0

def _reflect_stop(rel, label):
    return _kill_patterns((rel.replace("/", "[/]"),), label)

def _feishu_configured():
    return _mykey_flag("print(1 if getattr(mykey,'fs_app_id','') and getattr(mykey,'fs_app_secret','') else 0)")

def _manual_background_start():
    print(f"{WARN}未安装 systemd 服务，改用临时后台启动；重启电脑后不会自动恢复。")
    rc = 0
    if _feishu_configured():
        rc = max(rc, fsapp_start())
    else:
        print(f"{OK} 飞书未配置，跳过")
    rc = max(rc, wechat_start())
    rc = max(rc, _reflect_start("scheduler", "reflect/scheduler.py", "调度/提醒"))
    if _companion_enabled_flag():
        rc = max(rc, _reflect_start("companion", "reflect/penglai_companion.py", "主动陪伴"))
    return rc

def _manual_background_stop():
    rc = fsapp_stop()
    rc = max(rc, wechat_stop())
    rc = max(rc, _reflect_stop("reflect/scheduler.py", "调度/提醒"))
    if _companion_enabled_flag():
        rc = max(rc, _reflect_stop("reflect/penglai_companion.py", "主动陪伴"))
    return rc

def installed_services():
    """只返回真正装了 unit 文件的服务（companion 是 opt-in，可能没装）。
    ★无 systemd：直接返回核心两个，绝不调 systemctl——否则 update_supervisor
    在 macOS 上 _restart_targets()→installed_services() 撞 FileNotFoundError('systemctl') 崩溃，
    升级后服务不重启、报平安发不出（真实 macOS 运行中踩过：磁盘升到新版但跑的还是旧进程）。"""
    if not has_systemd():
        return SERVICES[:2]
    out = []
    for s in SERVICES:
        if sh(["systemctl", "list-unit-files", f"{s}.service"]).stdout.strip().count(s):
            out.append(s)
    return out

# ---------- 安全插件预检（F-011 把静默 fail-open 变成可检测/阻断）----------
GUARD_PLUGINS = ["plugins.penglai_redline", "plugins.penglai_memguard", "plugins.penglai_fileguard",
                 "plugins.penglai_logguard"]

def guardcheck():
    """验证安全插件（红线/记忆卫生/文件外发/日志脱敏）真正 import 且挂载。
    供 doctor / start / systemd 单元统一复用。0=已挂载 1=未挂载。
    机制：discover_and_load(strict=True) 聚合失败插件并抛错，坏插件默认阻断启动；
    PENGLAI_ALLOW_UNGUARDED=1 时退回 fail-open 仅用于显式救援。仍主动核验挂载点，
    否则 agent 可能在【无任何防护】下运行而无人知晓。"""
    try:
        sys.path.insert(0, ROOT)
        import plugins.hooks as h
        h.discover_and_load(strict=os.environ.get("PENGLAI_ALLOW_UNGUARDED") != "1")
        import ga
        miss = [m for m in GUARD_PLUGINS if m not in sys.modules]
        cr = ga.GenericAgentHandler.do_code_run.__module__
        fw = ga.GenericAgentHandler.do_file_write.__module__
        fg_ok = _probe_fileguard_mount()
        lg_ok = _probe_logguard_mount()
    except Exception as e:
        print(f"失败：导入错误：{e}"); return 1
    if not miss and cr != "ga" and fw != "ga" and fg_ok and lg_ok:
        print("通过：安全插件已挂载（红线/记忆卫生/文件外发/日志脱敏）"); return 0
    print(f"失败：未挂载 missing={miss} code_run={cr} file_write={fw} fileguard={fg_ok} logguard={lg_ok}"); return 1

def _probe_fileguard_mount():
    """模拟生产部署的真实路径：fsapp 以 `python frontends/fsapp.py` 跑时模块名是
    __main__。曾因 fileguard 只查 frontends.fsapp 在生产静默 fail-open 而 guardcheck
    假绿（2026-06-11 真机事故），此探针专门复现该形态，挂不上=FAIL。"""
    import types
    import plugins.penglai_fileguard as fg
    probe = types.ModuleType("__main__")
    probe.__file__ = os.path.join(ROOT, "frontends", "fsapp.py")
    probe._send_local_file = lambda *a, **k: True
    probe.send_message = lambda *a, **k: None
    saved_main = sys.modules.get("__main__")
    saved = (fg._PATCHED, fg._orig_send_local_file, fg._orig_send_generated_files, fg._fsapp_mod)
    try:
        fg._PATCHED, fg._orig_send_local_file, fg._orig_send_generated_files, fg._fsapp_mod = False, None, None, None
        sys.modules["__main__"] = probe
        mounted = fg._try_patch()
        wrapped = probe._send_local_file is fg._guarded_send_local_file
        return bool(mounted and wrapped)
    finally:
        if saved_main is not None:
            sys.modules["__main__"] = saved_main
        fg._PATCHED, fg._orig_send_local_file, fg._orig_send_generated_files, fg._fsapp_mod = saved

def _probe_logguard_mount():
    import llmcore
    return bool(getattr(llmcore._write_llm_log, "_penglai_logguard", False))

def guard_ok():
    """以 venv python 子进程跑 guardcheck，返回 (ok, 末行详情)。doctor/start 复用。"""
    r = sh([venv_python(), os.path.join(ROOT, "penglai"), "_guardcheck"], cwd=ROOT)
    lines = (r.stdout or "").strip().splitlines()
    last = lines[-1] if lines else ((r.stderr or "").strip().splitlines() or [""])[-1]
    return (r.returncode == 0 and (last.startswith("通过") or last.startswith("OK"))), last

def _feishu_runtime_wrapper_status():
    """Low-side-effect Feishu wrapper check: no WSS, no LLM, no message send."""
    import json
    r = sh([venv_python(), os.path.join(ROOT, "penglai_feishu_app.py"), "--check"], cwd=ROOT)
    text = r.stdout or ""
    start = text.find("{")
    if r.returncode != 0 or start < 0:
        return False, False, f"penglai_feishu_app.py --check 失败: {(r.stderr or text).strip()[:160]}"
    try:
        data = json.loads(text[start:])
    except Exception as e:
        return False, False, f"飞书检查输出无法解析: {e}"
    configured = bool(data.get("app_id") or data.get("app_secret_present"))
    runtime = data.get("runtime_hub") or {}
    ok = bool(data.get("ready") and runtime.get("ok"))
    detail = (
        f"ready={data.get('ready')} runtime={runtime.get('ok')} "
        f"card_action={runtime.get('card_action_supported')}"
    )
    return configured, ok, detail

# ---------- doctor ----------
def _owner_open_id_from_log():
    """从 fsapp.log 的「收到消息 [X]」里捞最常出现的 open_id——白名单为空时建议收紧目标（F4）。"""
    if not os.path.exists(FSLOG):
        return ""
    try:
        import re, collections
        ids = re.findall(r"收到消息 \[([^\]]+)\]",
                         open(FSLOG, encoding="utf-8", errors="replace").read())
        return collections.Counter(ids).most_common(1)[0][0] if ids else ""
    except Exception:
        return ""

def _detect_legacy_030_processes():
    """检测 0.3.0 残留进程（Task 22 / 031rootv2 §11.2）。

    扫描进程列表找 penglai 相关进程，如果发现旧版本入口进程
    （通过命令行特征），返回旧进程描述列表。
    """
    legacy_patterns = (
        ("frontends/fsapp[.]py", "飞书旧入口 frontends/fsapp.py"),
        ("frontends/wechatapp[.]py", "微信旧入口 frontends/wechatapp.py"),
        ("frontends/dingtalkapp[.]py", "钉钉旧入口 frontends/dingtalkapp.py"),
        ("frontends/wecomapp[.]py", "企微旧入口 frontends/wecomapp.py"),
        ("frontends/qqapp[.]py", "QQ 旧入口 frontends/qqapp.py"),
        ("frontends/tgapp[.]py", "Telegram 旧入口 frontends/tgapp.py"),
        ("agentmain[.]py --reflect reflect/penglai_companion", "companion 旧 reflect 入口"),
        ("agentmain[.]py --reflect reflect/scheduler", "scheduler 旧 reflect 入口"),
    )
    found = []
    for pat, label in legacy_patterns:
        pids = _pids_for_patterns((pat,))
        if pids:
            pid_str = ", ".join(str(p) for p in pids[:3])
            found.append(f"{label} (PID {pid_str})")
    return found

