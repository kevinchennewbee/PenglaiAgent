.git
.gitignore
.dockerignore

# Local/private runtime state
mykey.py
mykey.py.bak*
.env
auth.json
model_responses.txt
temp/
tmp/
audit/
_internal/
.internal/
.claude/
tasks/
sche_tasks/
skills/expense-log.md
penglai-migrate-backup-*/

# Browser automation local secrets
assets/tmwd_cdp_bridge/config.js
assets/copilot_proxy.pyw

# Python/build/cache artifacts
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/
build/
dist/
*.egg-info/
installer/dist/
installer/*.egg-info/

# Editor/OS/log artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*.log
**log.*

# Local memory generated at runtime; keep source-controlled SOPs in the repo,
# but never copy generated user memory into Docker build contexts.
memory/global_mem.txt
memory/global_mem_*.txt
memory/global_mem_insight.txt
memory/vision_api.py
memory/history_insight/
memory/**/history_insight/
memory/L4_raw_sessions/*.txt
memory/L4_raw_sessions/*.zip
memory/L4_raw_sessions/*.jsonl
