{
  "name": "penglaiagent",
  "version": "0.5.7",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": "22.22.2",
    "pnpm": "10.14.0"
  },
  "pnpm": {
    "overrides": {
      "@liustack/pptfast>sharp": "0.35.3",
      "exceljs>uuid": "11.1.1",
      "exceljs>unzipper": "0.12.5",
      "pptxgenjs>image-size": "workspace:*",
      "onnxruntime-node>adm-zip": "0.6.0",
      "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
      "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
      "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
      "@deepseek-ai/dsh-compaction": "0.1.1-rc.2",
      "@deepseek-ai/dsh-code-runtime": "0.1.1-rc.2",
      "@deepseek-ai/dsh-sandbox": "0.1.1-rc.2",
      "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
      "@deepseek-ai/dsh-atomic-write": "0.1.1-rc.2",
      "@deepseek-ai/dsh-session-telemetry": "0.1.1-rc.2",
      "@deepseek-ai/dsh-anonymous-user-id": "0.1.1-rc.2",
      "@deepseek-ai/dsh-shell": "0.1.1-rc.2",
      "@deepseek-ai/dsh-output-retention": "0.1.1-rc.2",
      "@deepseek-ai/dsh-workflow": "0.1.1-rc.2",
      "@deepseek-ai/dsh-bash-local": "0.1.1-rc.2",
      "@deepseek-ai/dsh-session-title-llm": "0.1.1-rc.2",
      "@deepseek-ai/dsh-spill": "0.1.1-rc.2",
      "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.1-rc.2"
    }
  },
  "scripts": {
    "format:check": "node scripts/format-check.mjs",
    "lint": "tsc -b --pretty false --force",
    "typecheck": "tsc -b --pretty false --force",
    "test:unit": "node --import tsx --test packages/contracts/src/*.test.ts packages/artifacts/src/*.test.ts packages/audio-codecs/src/*.test.ts packages/routing-core/src/*.test.ts packages/persistence/src/*.test.ts packages/testkit/src/*.test.ts packages/local-control/src/*.test.ts packages/runtime/src/*.test.ts packages/plugin-registry/src/*.test.ts packages/plugin-center/src/*.test.ts packages/plugin-reference/src/*.test.ts packages/plugin-pilot/src/*.test.ts packages/release-identity/src/*.test.ts packages/asr/src/*.test.ts packages/moss-tts/src/*.test.ts packages/context/src/*.test.ts packages/memory/src/*.test.ts packages/memory/src/engine/*.test.ts packages/memory/src/v2/*.test.ts packages/im/src/registry.test.ts packages/office/src/*.test.ts packages/budget/src/*.test.ts packages/companion/src/*.test.ts scripts/lib/evidence-dir.test.mjs scripts/lib/mnemon-fetch.test.mjs scripts/lib/candidate-source.test.mjs scripts/lib/dsh-source-closure.test.mjs scripts/lib/secret-scan.test.mjs scripts/lib/tap-diagnostics.test.mjs scripts/lib/assemble-release.test.mjs scripts/lib/package-metadata.test.mjs scripts/lib/dsh-closure.test.mjs scripts/lib/sbom-lock.test.mjs scripts/lib/license-inventory.test.mjs",
    "test:contract": "node --import tsx --test packages/dsh-bridge/src/*.test.ts packages/channel-weixin/src/*.test.ts packages/channel-mock/src/*.test.ts packages/channel-feishu/src/*.test.ts packages/channel-dingtalk/src/*.test.ts packages/channel-wecom/src/*.test.ts packages/channel-qq/src/*.test.ts packages/channel-slack/src/*.test.ts packages/channel-telegram/src/*.test.ts packages/channel-discord/src/*.test.ts",
    "test:integration": "node --import tsx --test packages/im/src/*.test.ts packages/im/src/adapters/*.test.ts",
    "test:e2e": "node --import tsx --test apps/desktop/src/*.test.ts",
    "test:e2e:installed": "node scripts/e2e-installed.mjs",
    "test:e2e:installed:live": "node scripts/e2e-installed-live.mjs",
    "test:u3:welcome": "node scripts/u3-welcome-smoke.mjs",
    "test:u3:plugins": "node scripts/u3-first-party-plugins.mjs",
    "test:failure-baseline": "node --import tsx scripts/failure-baseline.mjs",
    "test:security": "node --import tsx --test packages/routing-core/src/security.test.ts packages/local-control/src/security.test.ts apps/desktop/src/security.test.ts",
    "test:chaos": "node --import tsx --test packages/routing-core/src/chaos.test.ts packages/persistence/src/chaos.test.ts",
    "test:fault": "node --import tsx --test packages/routing-core/src/chaos.test.ts packages/persistence/src/chaos.test.ts",
    "test:soak": "node --import tsx --test packages/routing-core/src/soak.test.ts",
    "test:soak:installed": "node scripts/soak-installed.mjs",
    "test:soak:usable": "node --import tsx scripts/soak-usable.mjs",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "audit:supply-chain": "node scripts/audit-dependencies.mjs && node scripts/audit-licenses.mjs && node scripts/sbom.mjs && node --import tsx scripts/third-party-notices.mjs",
    "sbom": "node scripts/sbom.mjs",
    "notices": "node --import tsx scripts/third-party-notices.mjs",
    "build": "tsc -b && node scripts/copy-moss-runtime.mjs && node scripts/copy-desktop-static.mjs && node scripts/bundle-desktop.mjs",
    "bundle:desktop": "node scripts/bundle-desktop.mjs",
    "pack:plugins": "node scripts/pack-plugins.mjs",
    "package:mac": "node scripts/package-mac.mjs --target darwin-arm64",
    "package:mac:arm": "node scripts/package-mac.mjs --target darwin-arm64",
    "package:mac:intel": "node scripts/package-mac.mjs --target darwin-x64",
    "package:dmg:arm": "node scripts/build-local-dmg.mjs --target darwin-arm64",
    "package:dmg:intel": "node scripts/build-local-dmg.mjs --target darwin-x64",
    "build:windows-host": "node scripts/build-windows-host.mjs",
    "package:windows-payload": "node scripts/package-windows-payload.mjs",
    "package:windows": "node scripts/package-windows-nsis.mjs",
    "build:local-dmg": "node scripts/build-local-dmg.mjs --target darwin-arm64",
    "verify:versions": "node scripts/verify-versions.mjs",
    "verify:identity": "node --import tsx scripts/verify-identity.mjs",
    "verify:contracts": "node --import tsx scripts/verify-contracts.mjs",
    "verify:dependencies": "node scripts/verify-dependencies.mjs",
    "verify:058-migration-inventory": "node scripts/verify-058-migration-inventory.mjs",
    "verify:058-overlay-map": "node scripts/verify-058-overlay-map.mjs",
    "verify:dsh-source-contract": "node scripts/prepare-dsh-source-closure.mjs --contract-only",
    "prepare:dsh-source-closure": "node scripts/prepare-dsh-source-closure.mjs",
    "promote:dsh-source-closure": "node scripts/promote-dsh-source-closure.mjs",
    "verify:dsh-vendored-closure": "node scripts/verify-dsh-vendored-closure.mjs",
    "verify:dsh-alpha-owner-remotes": "node scripts/verify-dsh-alpha-owner-remotes.mjs",
    "verify:retired-channel": "node scripts/verify-retired-channel-absence.mjs",
    "verify:closure": "node scripts/verify-closure.mjs",
    "verify:profile": "node --import tsx scripts/verify-profile.mjs",
    "verify:profile:voice-matrix": "node --import tsx scripts/verify-profile.mjs --voice-matrix",
    "verify:artifact": "node scripts/verify-artifact.mjs",
    "verify:bundled-runtime": "node --import tsx scripts/verify-bundled-runtime.mjs",
    "verify:fuses": "node --import tsx scripts/verify-fuses.mjs",
    "verify:signing": "node scripts/verify-signing.mjs",
    "verify:notarization": "node scripts/verify-notarization.mjs",
    "verify:evidence": "node --import tsx scripts/verify-evidence.mjs",
    "verify:release": "node --import tsx scripts/verify-release.mjs",
    "verify:installed": "node --import tsx scripts/verify-installed.mjs",
    "verify:live": "node --import tsx scripts/verify-live.mjs",
    "verify:live-plugin-catalog": "node --import tsx scripts/verify-live-plugin-catalog.mjs",
    "verify:public-export": "node --import tsx scripts/verify-public-export.mjs",
    "prepare:public-export": "node --import tsx scripts/prepare-public-export.mjs",
    "verify:clean-clone": "node --import tsx scripts/verify-clean-clone.mjs",
    "sign:catalog": "node --import tsx scripts/sign-catalog.mjs",
    "sign:plugin-artifact": "node --import tsx scripts/sign-plugin-artifact.mjs",
    "sign:update-manifest": "node --import tsx scripts/sign-update-manifest.mjs",
    "assemble:release": "node --import tsx scripts/assemble-release.mjs",
    "readback:release": "node --import tsx scripts/readback-release.mjs",
    "rotate:release-keys": "node scripts/rotate-release-keys.mjs",
    "verify:soak": "node --import tsx scripts/verify-soak.mjs",
    "verify:memory-real": "node --import tsx scripts/verify-memory-real.mjs",
    "verify:office-real": "node --import tsx scripts/verify-office-real.mjs",
    "verify:community-candidates": "node --import tsx scripts/verify-community-candidates.mjs",
    "fetch:mnemon-assets": "node --import tsx scripts/fetch-mnemon-assets.mjs --host-only",
    "verify:asr-real": "node --import tsx scripts/verify-asr-real.ts",
    "verify:moss-real": "node --import tsx scripts/verify-moss-real.ts",
    "progress": "node scripts/progress.mjs",
    "probe:r2": "node scripts/probe-r2.mjs",
    "evidence:r2": "node scripts/evidence-r2.mjs",
    "verify:r2": "node scripts/verify-r2.mjs",
    "verify:r1": "node scripts/verify-r1.mjs",
    "probe:dsh": "node --import tsx packages/dsh-bridge/src/probe.ts",
    "probe:dsh-contracts": "node scripts/probe-dsh-contracts.mjs",
    "probe:dsh-u0": "node --import tsx scripts/probe-dsh-u0.mjs",
    "probe:rc2": "node --import tsx scripts/probe-rc2.mjs",
    "probe:rc1": "node --import tsx scripts/probe-rc2.mjs",
    "probe:makers": "node --import tsx scripts/probe-makers.mjs",
    "ensure:electron": "node scripts/ensure-electron.mjs"
  },
  "devDependencies": {
    "@types/node": "22.16.5",
    "esbuild": "0.25.9",
    "resedit": "3.0.2",
    "tsx": "4.20.3",
    "typescript": "5.9.2"
  }
}
