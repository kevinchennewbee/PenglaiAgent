def _ensure_macos_reflects(force=False):
    """macOS：确保 reflect 心跳被 launchd 守护拉起——scheduler(提醒/日程，内核标配，必装；旧版 macOS
    根本没起它=提醒到点不触发) + companion(仅用户已开时)。Linux 由 systemd 管，跳过。
    force=True(升级/重启后)：即便在跑也重装让它们 re-exec 新码（否则跑升级前旧码，P2 升级一致性）。"""
    if has_systemd():
        return
    try:
        sys.path.insert(0, ROOT)
        import penglai_abilities as pa
        pa._install_reflect_service("penglai-scheduler", "reflect/scheduler.py", "提醒/日程")
        if pa._companion_on() and (force or not pa._companion_running()):
            pa._install_reflect_service("penglai-companion", "reflect/penglai_companion.py", "主动陪伴")
    except Exception as e:
        print(f"{WARN}reflect 守护处理跳过: {e}")

def _non_systemd_status():
    rows = [
        ("penglai-feishu", FSAPP_PATTERNS, _mykey_flag(
            "print(1 if getattr(mykey,'fs_app_id','') and getattr(mykey,'fs_app_secret','') else 0)"
        ), "飞书未配置"),
        ("penglai-scheduler", ("reflect/scheduler[.]py",), True, "核心调度器"),
        ("penglai-companion", ("reflect/penglai_companion[.]py",),
         _companion_enabled_flag(), "主动陪伴未启用"),
        ("penglai-wechat", ("penglai_im_launch[.]py wechat", "frontends/wechatapp[.]py"),
         _wechat_bound(), "微信未绑定"),
    ]
    for name, patterns, configured, disabled_text in rows:
        pids = _pids_for_patterns(patterns)
        launchd = _launchd_loaded(name)
        if pids:
            detail = f"running (PID {pids[0]}"
            if len(pids) > 1:
                detail += f", +{len(pids) - 1}"
            detail += ")"
        elif not configured:
            detail = f"not enabled ({disabled_text})"
        else:
            detail = "stopped"
        if sys.platform == "darwin":
            detail += f"; launchd {'loaded' if launchd else 'not loaded'}"
        print(f"  {name}: {detail}")
    return 0

def svc(action):
    # 启动前 fail-closed：安全插件没挂载就拒绝启动，别让 agent 无防护裸奔（F-011）
    if action in ("start", "restart") and os.environ.get("PENGLAI_ALLOW_UNGUARDED") != "1":
        ok, detail = guard_ok()
        if not ok:
            print(f"{BAD} 安全插件未挂载（{detail}）——为防止 agent 无防护运行，拒绝启动。")
            print("   修复 plugins/penglai_{redline,memguard,fileguard}.py 导入错误后重试，"
                  "或 PENGLAI_ALLOW_UNGUARDED=1 强制启动（危险，不建议）。")
            return 2
    # U7：restart 由 agent/IM(非 tty)触发时，派生脱离进程组的监工去重启 + 健康检查 + 带外回报
    # 『我回来了』，不在当前进程(可能是被重启 fsapp 的子进程)里同步杀服务。终端当面跑保留同步路径。
    if action == "restart" and not (sys.stdin.isatty() and sys.stdout.isatty()):
        os.makedirs(os.path.join(ROOT, "temp"), exist_ok=True)
        lf = open(os.path.join(ROOT, "temp", "restart_supervisor.log"), "ab")
        subprocess.Popen([venv_python(), os.path.join(ROOT, "penglai"), "_restart_supervisor"],
                         cwd=ROOT, stdout=lf, stderr=subprocess.STDOUT,
                         stdin=subprocess.DEVNULL, start_new_session=True)
        print(f"{OK} 已派后台监工重启，约 15 秒后我会发条消息告诉你我回来了。")
        return 0
    if not has_systemd():
        # 容器/macOS：直接管理 nohup 飞书进程
        if action == "status":
            return _non_systemd_status()
        if action == "start":
            r = fsapp_start()
            r = max(r, wechat_start())
            _ensure_macos_reflects()
            return r
        if action == "stop":
            r = fsapp_stop()
            r = max(r, wechat_stop())
            return r
        if action == "restart":
            fsapp_stop()
            wechat_stop()
            r = fsapp_start()
            r = max(r, wechat_start())
            _ensure_macos_reflects(force=True)
            return r
    svcs = installed_services()
    if not svcs:
        if action == "status":
            return _non_systemd_status()
        if action == "start":
            return _manual_background_start()
        if action == "stop":
            return _manual_background_stop()
        if action == "restart":
            _manual_background_stop()
            return _manual_background_start()
    if action == "status":
        for s in svcs:
            r = sh(["systemctl", "is-active", s])
            print(f"  {s}: {r.stdout.strip()}")
        return 0
    r = subprocess.run(["sudo", "systemctl", action] + svcs)
    if r.returncode == 0 and action in ("start", "restart"):
        print(f"{OK} 已{('重' if action == 'restart' else '')}启动。penglai logs 可查看日志")
    return r.returncode

