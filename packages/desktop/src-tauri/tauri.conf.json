{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Penglai",
  "version": "0.4.1",
  "identifier": "com.penglai.agent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run prepare:runtime && npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self' data:; frame-src 'none'; object-src 'none'; base-uri 'self'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws://localhost:1420; font-src 'self' data:; frame-src 'none'; object-src 'none'; base-uri 'self'"
    },
    "windows": [
      {
        "title": "蓬莱 · Penglai",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGMjA3MDIwQUFFOURFNzcKUldSMzN1bXFJSEFnSDhkdVJ4M3lqTGRYU09mTlY1azAybHZ0ODhxRFJCTUI5NlBRR0RDRUUwUDUK",
      "endpoints": [
        "https://github.com/kevinchennewbee/PenglaiAgent/releases/download/desktop-v0.4/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "nsis",
      "dmg"
    ],
    "publisher": "PenglaiAgent",
    "homepage": "https://github.com/kevinchennewbee/PenglaiAgent",
    "category": "Productivity",
    "resources": [
      "resources/host-runtime/**/*"
    ],
    "shortDescription": "Penglai 0.4 — local AI workbench",
    "longDescription": "Penglai 0.4 is a local personal AI workbench: one conversation, full tools, project workspaces, permission dial, and durable Host. No system Node required.",
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "windows": {
      "allowDowngrades": false,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "Penglai",
        "compression": "lzma"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 245
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 245
        }
      }
    }
  }
}
