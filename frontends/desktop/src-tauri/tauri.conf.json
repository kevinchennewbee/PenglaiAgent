{
  "productName": "Penglai",
  "version": "0.3.6",
  "identifier": "com.penglai.agent",
  "build": {
    "frontendDist": "../static"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' http://127.0.0.1:14168 ws://127.0.0.1:14168 https://github.com https://api.github.com https://objects.githubusercontent.com; font-src 'self' data:"
    },
    "windows": [
      {
        "title": "蓬莱",
        "label": "main",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "visible": false,
        "url": "loading.html"
      },
      {
        "title": "蓬莱 — 启动设置",
        "label": "setup",
        "width": 680,
        "height": 800,
        "resizable": true,
        "visible": false,
        "center": true,
        "url": "fallback.html"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3MDU1MkJDRTJFNjM4NjMKUldSak9PYml2RklGSnlmNjhCQ0hreXRwS0NiaWMzNGs4V3hvdFlJRFpCcnlZRjFvZ3RMZ3VsOEoK",
      "endpoints": [
        "https://github.com/kevinchennewbee/PenglaiAgent/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "dmg", "app"],
    "publisher": "PenglaiAgent",
    "homepage": "https://github.com/kevinchennewbee/PenglaiAgent",
    "category": "Productivity",
    "resources": ["resources/penglai-runtime/**/*"],
    "shortDescription": "Penglai 0.3.6 desktop - trusted release gates and companion foundation",
    "longDescription": "Penglai desktop is the native control surface for PenglaiAgent 0.3.6. It provides a complete setup wizard (LLM, IM channels, abilities), multi-session chat workspace, Runtime Hub diagnostics, one-click update, system tray monitoring, local speech playback, trusted release gates, and Companion Loop foundation controls. macOS Apple Silicon, macOS Intel x64, and Windows x64.",
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "windows": {
      "allowDowngrades": false,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "Penglai",
        "compression": "lzma"
      }
    },
    "macOS": {
      "hardenedRuntime": true,
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 230
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 230
        }
      }
    }
  }
}
