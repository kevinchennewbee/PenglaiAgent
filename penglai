BACKUP_DIR = os.path.expanduser("~/.penglai/backups")

def _mykey_path():
    return os.path.join(ROOT, "mykey.py")

def _load_mykey_dict():
    """子进程 import mykey.py，返回公开变量 dict（失败返回 {}）。"""
    r = subprocess.run([sys.executable, "-c",
        "import mykey,json\n"
        "d={k:v for k,v in vars(mykey).items() if not k.startswith('_') and not callable(v)}\n"
        "print(json.dumps(d, default=str, ensure_ascii=False))"],
        cwd=ROOT, capture_output=True, text=True)
    if r.returncode != 0:
        return {}
    try:
        return json.loads(r.stdout)
    except ValueError:
        return {}

def config_cmd():
    """penglai config <backup|restore|status> [--json]"""
    sub = sys.argv[2] if len(sys.argv) > 2 else ""
    rest = sys.argv[3:]
    as_json = "--json" in rest
    pos = [a for a in rest if not a.startswith("-")]
    if sub == "backup":
        return config_backup()
    if sub == "restore":
        return config_restore(pos[0] if pos else None)
    if sub == "status" or (not sub and as_json):
        return config_status(as_json=as_json)
    print("用法: penglai config <backup|restore|status> [--json]")
    print("  backup          原子备份当前 mykey.py 到 ~/.penglai/backups/")
    print("  restore [备份]  从备份恢复（默认最近一个；恢复前自动存档当前）")
    print("  status --json   输出当前配置概览（哪些模块已配置）")
    return 0

def config_backup():
    src = _mykey_path()
    if not os.path.exists(src):
        print(f"{BAD} mykey.py 不存在，无内容可备份。先运行：penglai setup")
        return 1
    os.makedirs(BACKUP_DIR, exist_ok=True)
    import time
    dst = os.path.join(BACKUP_DIR, f"mykey.py.{time.strftime('%Y%m%d-%H%M%S')}")
    tmp = dst + ".tmp"   # 原子写入：tmp→rename（031rootv2 §4.5）
    shutil.copy2(src, tmp)
    os.replace(tmp, dst)
    print(f"{OK} 已备份 → {dst}")
    return 0

def config_restore(name=None):
    import glob, time
    if name:
        src = name if os.path.isabs(name) else os.path.join(BACKUP_DIR, name)
    else:
        cands = sorted(glob.glob(os.path.join(BACKUP_DIR, "mykey.py.*")))
        if not cands:
            print(f"{BAD} 没有备份可恢复（{BACKUP_DIR} 为空）。先 penglai config backup")
            return 1
        src = cands[-1]
    if not os.path.exists(src):
        print(f"{BAD} 备份不存在：{src}")
        return 1
    dst = _mykey_path()
    # 恢复前先存档当前 mykey.py（双保险：restore 失败也能回退）
    if os.path.exists(dst):
        cur_bak = f"{dst}.pre-restore.{time.strftime('%Y%m%d-%H%M%S')}"
        shutil.copy2(dst, cur_bak)
        print(f"  当前 mykey.py 已存档 → {os.path.basename(cur_bak)}")
    tmp = dst + ".tmp"
    shutil.copy2(src, tmp)
    try:
        os.chmod(tmp, 0o600)
    except OSError:
        pass
    os.replace(tmp, dst)
    print(f"{OK} 已从 {src} 恢复 mykey.py")
    print(f"   重启服务生效：penglai restart")
    return 0

