        items.append("~/.wxbot/token.json")
    # ~/.penglai_desktop_settings.json
    desktop_settings = os.path.expanduser("~/.penglai_desktop_settings.json")
    if os.path.exists(desktop_settings):
        shutil.copy2(desktop_settings, os.path.join(tmp_dir, ".penglai_desktop_settings.json"))
