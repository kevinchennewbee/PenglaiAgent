{
  "name": "@penglai/desktop",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Penglai 0.4 desktop shell - a Tauri 2 app that launches the TS Host (node) as its backend and wraps the 0.4 web UI.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepare:runtime": "node ../../scripts/sync-schema-versions.mjs && node ../host/scripts/build-runtime.mjs --out ./src-tauri/resources/host-runtime",
    "verify:runtime": "node ../host/scripts/verify-runtime.mjs --runtime ./src-tauri/resources/host-runtime",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:local": "node scripts/build-local-dmg.mjs",
    "tauri:build:release": "node ./scripts/require-release-signing.mjs && tauri build --ci",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@penglai/host": "*",
    "@penglai/protocol": "*",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
