            "backup": backup_cmd, "restore": restore_cmd,
            "uninstall-legacy": uninstall_legacy_cmd,
            "selfcheck": selfcheck_cmd, "runtime-run": runtime_run_cmd,
            "runtime-chat": runtime_chat_cmd,
            "runtime-status": runtime_status_cmd, "runtime-history": runtime_history_cmd,
            "runtime-cancel": runtime_cancel_cmd, "runtime-serve": runtime_serve_cmd,
            "runtime-service": runtime_service_cmd,
            "runtime-audit": runtime_audit_cmd,
            "privacy-audit": privacy_audit_cmd,
            "install-check": install_check_cmd,
            "tts-smoke": tts_smoke_cmd,
            "tts-say": tts_say_cmd,
            "tts-feishu-test": tts_feishu_test_cmd,
            "tts-voices": tts_voices_cmd,
            "feishu-service": feishu_service_cmd,
            "companion": companion_cmd,
            "_guardcheck": guardcheck, "_update_supervisor": update_supervisor,
            "_restart_supervisor": restart_supervisor}
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg in ("--version", "-V"):
        arg = "version"
    if not arg:
        # 裸跑：交互终端 → 直接进对话（对齐 hermes 体验）；管道/脚本 → 打印帮助
        if sys.stdin.isatty() and sys.stdout.isatty():
            return tui()
        print(__doc__.strip()); return 0
    if arg not in cmds:
        print(__doc__.strip()); return 0
    return cmds[arg]()

if __name__ == "__main__":
    sys.exit(main())
