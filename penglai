# ---------- 完整数据备份/恢复（0.3.1 版本迁移用）----------
def _copy_sqlite_consistent(src, dst):
    """Copy a SQLite database with WAL-safe backup API and integrity check."""
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    tmp = f"{dst}.tmp.{uuid.uuid4().hex}"
    try:
        with sqlite3.connect(src, timeout=30) as src_conn, sqlite3.connect(tmp) as dst_conn:
            src_conn.backup(dst_conn)
            check = dst_conn.execute("PRAGMA integrity_check").fetchone()
            if not check or check[0] != "ok":
                raise RuntimeError(f"SQLite integrity_check failed: {check[0] if check else 'no result'}")
        os.replace(tmp, dst)
    except Exception:
        try:
            os.remove(tmp)
        except OSError:
            pass
        raise


def _copy_file_atomic(src, dst):
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    tmp = f"{dst}.tmp.{uuid.uuid4().hex}"
    try:
        shutil.copy2(src, tmp)
        os.replace(tmp, dst)
    except Exception:
        try:
            os.remove(tmp)
        except OSError:
            pass
        raise


def _replace_tree_atomic(src, dst):
    parent = os.path.dirname(dst)
    os.makedirs(parent, exist_ok=True)
    tmp = os.path.join(parent, f".{os.path.basename(dst)}.restore-tmp-{uuid.uuid4().hex}")
    old = os.path.join(parent, f".{os.path.basename(dst)}.restore-old-{uuid.uuid4().hex}")
    try:
        shutil.copytree(src, tmp)
        if os.path.exists(dst):
            os.replace(dst, old)
        os.replace(tmp, dst)
        if os.path.exists(old):
            shutil.rmtree(old)
    except Exception:
        if os.path.exists(tmp):
            shutil.rmtree(tmp, ignore_errors=True)
        if os.path.exists(old) and not os.path.exists(dst):
            os.replace(old, dst)
        raise


def backup_cmd():
    """penglai backup — 完整数据备份（用于版本迁移前）"""
    import time
    ts = time.strftime('%Y%m%d-%H%M%S')
