    # mykey.py
    mykey = _mykey_path()
    if os.path.exists(mykey):
        shutil.copy2(mykey, os.path.join(tmp_dir, "mykey.py"))
        items.append("mykey.py")
    # memory/
    mem_dir = os.path.join(ROOT, "memory")
    if os.path.isdir(mem_dir):
        shutil.copytree(mem_dir, os.path.join(tmp_dir, "memory"), dirs_exist_ok=True)
