def is_git_repo():
    return sh(["git", "rev-parse", "--is-inside-work-tree"], cwd=ROOT).stdout.strip() == "true"

def _in_docker():
    return os.environ.get("PENGLAI_DOCKER") == "1" or os.path.exists("/.dockerenv")

REINSTALL_HINT = ("从 GitHub Releases 的 v0.3.6 页面下载固定版 install.sh，"
                  "先检查内容再本地执行；0.4 请安装桌面版或 TS CLI。")
UPDATE_LOG = os.path.join(ROOT, "temp", "update.log")

def _git(*args):
    cmd = ["git", *args]
    kw = {}
    if args and args[0] == "fetch":
        # 国内直连 GitHub 有时不是立刻失败，而是低速半开卡住。给 fetch 加
        # 明确低速阈值和总超时，失败后 _fetch_status() 才能快速切到 gh-proxy。
        cmd = ["git", "-c", "http.lowSpeedLimit=1024", "-c", "http.lowSpeedTime=8", *args]
        kw["timeout"] = 35
    try:
        return sh(cmd, cwd=ROOT, **kw)
    except subprocess.TimeoutExpired as e:
        out = e.stdout if isinstance(e.stdout, str) else (e.stdout or b"").decode("utf-8", "replace")
        err = e.stderr if isinstance(e.stderr, str) else (e.stderr or b"").decode("utf-8", "replace")
        return subprocess.CompletedProcess(cmd, 124, out, err or f"git fetch 在 {e.timeout} 秒后超时")


def _release_remote():
    preferred = os.environ.get("PENGLAI_RELEASE_REMOTE", "").strip()
    if preferred and _git("remote", "get-url", preferred).returncode == 0:
        return preferred
    for name in ("origin", "release"):
        r = _git("remote", "get-url", name)
        if r.returncode == 0 and "PenglaiAgent" in (r.stdout or ""):
            return name
    return "origin"


def _release_branch():
    explicit = os.environ.get("PENGLAI_RELEASE_BRANCH", "").strip()
    if explicit:
        return explicit
    try:
        from penglai_runtime.version import collect_version_metadata

        branch = (collect_version_metadata(root=ROOT).branch or "").strip()
        if branch and branch not in {"unknown", "HEAD"}:
            return branch
    except Exception:
        pass
    if is_git_repo():
        branch = _git("rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
        if branch and branch not in {"HEAD", "unknown"}:
            return branch
    return "main"


def _release_ref(remote=None):
    return f"{remote or _release_remote()}/{_release_branch()}"

def _verify_release_integrity(newsha, remote=None):
    """Fail closed unless the target release commit is cryptographically trusted.

    Source updates are code execution.  Compile/guardcheck catches broken code, but
    it cannot prove the fetched commit came from a trusted release.  The normal
    path accepts either a signed tag pointing at the target commit or a signed
    target commit.  Development and emergency use can bypass this only with an
    explicit dangerous environment flag.
    """
    newsha = (newsha or "").strip()
    if not newsha:
        return False, "目标 commit 为空"
    if os.environ.get("PENGLAI_ALLOW_UNSIGNED_UPDATE") == "1":
        return True, "PENGLAI_ALLOW_UNSIGNED_UPDATE=1"
    if os.environ.get("PENGLAI_UPDATE_REQUIRE_SIGNATURE", "1") == "0":
        return True, "PENGLAI_UPDATE_REQUIRE_SIGNATURE=0"
    remote = remote or _release_remote()
    _git("fetch", "--tags", remote)
    tag_proc = _git("tag", "--points-at", newsha)
    tags = [t.strip() for t in (tag_proc.stdout or "").splitlines() if t.strip()]
    for tag in tags:
        if not tag.startswith("v"):
            continue
        verify = _git("tag", "-v", tag)
        if verify.returncode == 0:
            return True, f"signed tag {tag}"
    commit_verify = _git("verify-commit", newsha)
    if commit_verify.returncode == 0:
        return True, "signed commit"
    detail = (commit_verify.stderr or commit_verify.stdout or "").strip()
    return False, (
        "目标版本缺少可信签名。请发布 signed tag 或 signed commit 后再升级；"
        "开发/应急环境可显式设置 PENGLAI_ALLOW_UNSIGNED_UPDATE=1。"
        + (f" git verify-commit: {detail[:160]}" if detail else "")
    )

def _gh_proxy(url):
    """把 github.com 直连 URL 包成可配置 GitHub 镜像（国内 GFW 兜底，与 install.sh 同源）。
    非 github / 已是镜像 返回空串。"""
    url = (url or "").strip()
    proxy = os.environ.get("PENGLAI_GH_PROXY", "").strip()
    if proxy and not proxy.endswith("/"):
        proxy += "/"
    if not url or not proxy or url.startswith(proxy) or "github.com" not in url:
        return ""
    return proxy + url

def _fetch_status():
    """返回 (ok, behind, oldsha, newsha, errmsg)。处理浅克隆补全 + ff 可行性。"""
    if not is_git_repo():
        return False, 0, "", "", f"压缩包安装（无 git 历史），无法增量更新。重装即最新：\n   {REINSTALL_HINT}"
    remote = _release_remote()
    ref = _release_ref(remote)
    if _git("rev-parse", "--is-shallow-repository").stdout.strip() == "true":
        print("  首次检查：补全 git 历史（浅克隆 → 完整）...")
        _git("fetch", "--unshallow", remote)
    if _git("fetch", remote).returncode != 0:
        # F5：直连 GitHub 失败（国内 GFW）→ 走可配置 GitHub 镜像，把目标分支拉进同一 remote ref
        proxied = _gh_proxy(_git("remote", "get-url", remote).stdout.strip())
        branch = _release_branch()
        if not proxied or _git("fetch", proxied, f"{branch}:refs/remotes/{remote}/{branch}").returncode != 0:
            return False, 0, "", "", "拉取失败（直连与 GitHub 镜像均失败，检查网络/代理）"
        print("  （直连 GitHub 失败，已走 GitHub 镜像拉取）")
    old = _git("rev-parse", "HEAD").stdout.strip()
    new = _git("rev-parse", ref).stdout.strip()
    behind = int(_git("rev-list", "--count", f"HEAD..{ref}").stdout.strip() or "0")
    if behind:
        ok, verify_detail = _verify_release_integrity(new, remote=remote)
        if not ok:
            return False, behind, old, new, verify_detail
    return True, behind, old, new, ""

def _changelog(old, new):
    r = _git("log", "--oneline", "--no-decorate", f"{old}..{new}")
    return [l for l in r.stdout.splitlines() if l.strip()]

def _preflight():
    """重启前冒烟：①全仓编译（语法）②安全插件 import+挂载。返回 (ok, detail)。
    新代码连编译/挂载都过不了，就根本不碰正在跑的服务（在杀服务之前拦住坏更新）。"""
    c = sh([venv_python(), "-m", "compileall", "-q", ROOT])
    if c.returncode != 0:
        return False, "编译失败：" + (c.stdout or c.stderr or "")[:200]
    g = sh([venv_python(), os.path.join(ROOT, "penglai"), "_guardcheck"])
    if g.returncode != 0:
        return False, "安全插件挂载失败：" + (g.stdout or "")[:200]
    legacy = sh([venv_python(), os.path.join(ROOT, "penglai"), "runtime-audit", "--json"])
    if legacy.returncode != 0:
        return False, "旧 Runtime 入口审计失败：" + ((legacy.stdout or legacy.stderr or "")[:300])
    try:
        data = json.loads(legacy.stdout or "{}")
    except Exception:
        return False, "旧 Runtime 入口审计输出不可解析"
    active = [
        item.get("item_id", "active_legacy_path")
        for item in data.get("items", [])
        if item.get("status") == "active_legacy_path"
    ]
    if active:
        return False, "旧 Runtime 入口仍在运行，0.3.0 不做原地重启升级：" + ", ".join(active[:5])
    return True, ""

