# Byte-pinned third-party notices and vendored runtime sources must be
# identical on every native checkout. Git for Windows otherwise rewrites
# these text files to CRLF and breaks the supply-chain hash gate.
packages/asr/third_party/*.txt text eol=lf
packages/moss-tts/third_party/*.txt text eol=lf
packages/moss-tts/third_party/*.md text eol=lf
packages/moss-tts/src/third_party/moss_tts/LICENSE text eol=lf
packages/moss-tts/src/third_party/moss_tts/runtime.mjs text eol=lf
third_party/sharp/*.txt text eol=lf
third_party/sharp/*.md text eol=lf

# Overlay hashes are release inputs. Keep source text byte-identical on
# Windows instead of letting core.autocrlf invalidate the pinned manifest.
overlays/dsh-0.1.1-rc.2/**/*.js text eol=lf
overlays/dsh-0.1.1-rc.2/**/*.html text eol=lf
overlays/dsh-0.1.1-rc.2/**/*.json text eol=lf

# Fixed-source DSH package inputs are reviewed by their SHA-256 manifest and
# must never be line-ending filtered or diffed as text.
third_party/dsh/**/*.tgz binary
third_party/dsh/**/closure-manifest.json text eol=lf

# Official npm cohort snapshots and locks are cross-target release identity inputs.
docs/*/DSH_NPM_COHORT.json text eol=lf
docs/*/DSH_ALPHA_PACKAGED_BYTES.json text eol=lf
pnpm-lock.yaml text eol=lf
pnpm-workspace.yaml text eol=lf

# Official session JSONL and other digest-bound testdata must stay LF on every
# checkout. Git for Windows otherwise rewrites them to CRLF and invalidates
# the committed provenance hash (U02 rc.1 v0 log 7dc9ca08… vs CRLF c2a03bce…).
packages/runtime/testdata/** text eol=lf
**/*.jsonl text eol=lf
