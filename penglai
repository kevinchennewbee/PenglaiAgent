            "status": lambda: svc("status"), "start": lambda: svc("start"),
            "stop": lambda: svc("stop"), "restart": lambda: svc("restart"),
            "logs": logs, "update": update, "setup": setup, "migrate": migrate,
            "skill": skill, "tui": tui,
